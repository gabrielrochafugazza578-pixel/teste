const RUMORS := [
	"Tem um bicho enorme perto do ferro-velho. Anda com o ombro na frente, que nem touro. Não enfrenta de frente.",
	"Uns amarelos, cheios de caroço, soltam uma poeira. Quem respira fica tossindo dias. Máscara, meu amigo.",
	"De noite eles enxergam menos, mas ouvem mais. Anda devagar.",
	"Os Despertos estão levando gente pra capela. Dizem que é pra 'despertar'. Ninguém volta.",
	"O rádio pegou uma transmissão ontem. Só estática e uma voz de mulher. Depois nada.",
	"Carro abandonado ainda tem gasolina no tanque, se tiver mangueira.",
	"Os que ficam parados no escuro não estão dormindo. Não passa perto.",
	"Os Corvos pegaram mais um caminhão na estrada da serra.",
	"A Corvalis tem gente armada ainda. Uniforme preto. Atiram primeiro.",
	"Chove, os bichos ficam mais lentos. Ou é impressão minha.",
	"Na Vila Operária a água da caixa ainda é boa. Ferve antes, sempre.",
	"Tem um bunker no meio da Mata do Sabiá. Dizem que é do tempo do exército.",
]


static func tree(id: String) -> Dictionary:
	return TREES.get(id, TREES["_generic"])


static func rumor(seed_value: int) -> String:
	return RUMORS[absi(seed_value) % RUMORS.size()]
