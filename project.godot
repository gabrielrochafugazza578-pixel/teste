; Engine configuration file.
; O INÍCIO DO FIM — configuração do projeto (Godot 4.7.x, renderer Compatibility)
;
; Todas as ações de input são registradas em runtime por scripts/core/input_setup.gd
; (isso permite remapeamento salvo em user://settings.cfg sem editar este arquivo).

config_version=5

[application]

config/name="O Início do Fim"
config/description="Survival horror de mundo aberto. Projeto NEXUS. Renderer Compatibility, otimizado para i3-4130 + GTX 750 Ti."
config/version="0.9.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="o_inicio_do_fim"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.02, 0.02, 0.025, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
Settings="*res://scripts/core/settings.gd"
Pad="*res://scripts/core/pad_input.gd"
GameState="*res://scripts/core/game_state.gd"
ItemDB="*res://scripts/inventory/item_db.gd"
SimScheduler="*res://scripts/core/sim_scheduler.gd"
Assets="*res://scripts/core/asset_library.gd"
TimeManager="*res://scripts/time/time_manager.gd"
WeatherManager="*res://scripts/weather/weather_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
FactionManager="*res://scripts/factions/faction_manager.gd"
MissionManager="*res://scripts/missions/mission_manager.gd"
StoryManager="*res://scripts/story/story_manager.gd"
SaveManager="*res://scripts/save/save_manager.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/inference_on_variant=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/unused_variable=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_signal=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/redundant_await=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/unused_private_class_variable=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

common/snap_controls_to_pixels=true
theme/default_font_antialiasing=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="infected"
3d_physics/layer_5="vehicle"
3d_physics/layer_6="interact"
3d_physics/layer_7="prop"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/default_gravity=9.8
3d/sleep_threshold_linear=0.12
3d/time_before_sleep=0.4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
textures/vram_compression/import_s3tc_bptc=true
textures/default_filters/anisotropic_filtering_level=2
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_debanding=false
environment/defaults/default_clear_color=Color(0.04, 0.045, 0.05, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/16_bits=true
lights_and_shadows/positional_shadow/atlas_size=1024
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/atlas_16_bits=true
limits/opengl/max_renderable_lights=24
limits/opengl/max_lights_per_object=6
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=2.0
driver/threads/thread_model=1
gl_compatibility/driver="opengl3"
gl_compatibility/fallback_to_gles=true

[shader_globals]

wetness={
"type": "float",
"value": 0.0
}
world_decay={
"type": "float",
"value": 1.0
}
veg_growth={
"type": "float",
"value": 1.0
}
city_power={
"type": "float",
"value": 0.0
}
blackout_origin={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
blackout_radius={
"type": "float",
"value": 0.0
}
wind={
"type": "vec4",
"value": Vector4(1, 0, 0.3, 0.3)
}
rain_intensity={
"type": "float",
"value": 0.0
}
daylight={
"type": "float",
"value": 1.0
}
player_world_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
detail_distance={
"type": "float",
"value": 60.0
}
